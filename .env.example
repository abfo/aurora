# Copy this file to .env and fill in your local values.
# Do NOT commit your real secrets.

###
# ASSISTANT CONFIGURATION (REQUIRED)

# Aurora uses the OpenAI GPT-Live, Responses and TTS APIs, an OpenAI API key is required.
# https://platform.openai.com/
OPENAI_API_KEY=

# Aurora uses a self-trained, fully local wake word model ("Aurora"). A model is
# checked into wake_word/models/aurora.onnx. To train or improve it (add your own
# voice recordings and retrain), see wake_word/README.md.
# WAKE_WORD_MODEL_PATH defaults to wake_word/models/aurora.onnx.
WAKE_WORD_MODEL_PATH=
# Detection threshold 0-1. Lower = more sensitive (more false positives, fewer
# missed wakes). Leave blank to use the value saved with the model.
WAKE_WORD_THRESHOLD=

# Wake word training (optional). Default off. When set to true, Aurora offers a
# voice-guided "help me train you" tool AND saves a ~1.2s WAV for every wake-word
# activation under <collect dir>/activations/ for you to review and sort into
# positive/negative training data. Leave blank/false for normal use.
WAKE_WORD_TRAINING_ENABLED=
# Folder for wake-word training recordings (positives/, negatives/, activations/
# subfolders). Defaults to wake_word/data/collected.
WAKE_WORD_COLLECT_DIR=

# Audio input and output devices IDs. Aurora logs available devices at startup, set LOG_LEVEL to
# INFO and run main.py to see the list of devices.
INPUT_DEVICE_ID=
OUTPUT_DEVICE_ID=

# Path to the live prompt: the voice persona, speaking style and the policy for
# when to hand work to the backend. There is a basic default but creating a
# custom version is highly recommended - see assets/example_instructions.md.
AGENT_INSTRUCTIONS_PATH=

# Path to the backend prompt: how the backend agent picks tools and reports
# results. Defaults to a minimal built-in prompt - see
# assets/example_backend_instructions.md.
BACKEND_INSTRUCTIONS_PATH=

# GPT-Live voice model to use. Defaults to 'gpt-live-1'
# https://developers.openai.com/api/docs/guides/live
LIVE_MODEL=

# Model for the backend agent that GPT-Live delegates tasks to. This is the one
# that reasons about tools; the voice model only listens and speaks.
# Defaults to 'gpt-5.6-luna'
BACKEND_MODEL=

# Voice to use for GPT-Live and TTS speach. Defaults to 'shimmer'
AGENT_VOICE=

# GPT-Live has no end-of-response event, so Aurora closes the session herself
# after this many seconds with nothing said in either direction and nothing
# left to play. Set to 0 to disable. Defaults to 30. Disabled while cooking.
IDLE_TIMEOUT_SECONDS=

# GPT-Live is full duplex and handles interruptions itself, so Aurora streams
# the mic continuously and you can talk over her. On hardware where the speaker
# bleeds into the mic (no echo cancellation) she may hear herself - set this to
# true to stop sending mic audio while she is speaking. Costs the ability to
# interrupt her. Defaults to false.
MUTE_INPUT_WHILE_SPEAKING=

###
# UI CONFIGURATION (OPTIONAL)

# The default Debug UI implemention reports interface state changes to the log. The Braincraft
# implementation is designed for a Raspberry PI 4 with an AdaFruit BrainCraft HAT - see the 
# project README.md for more information about this configuration. Debug should work on any device
# that has a microphone and speaker available.
UI=Debug

# If using Braincraft ALARM_FONT_PATH is the font to use for timer notifications and the four image
# paths are used for the talk, listen and sleep and tool calling states.
ALARM_FONT_PATH=
IMAGE_TALK_PATH=
IMAGE_LISTEN_PATH=
IMAGE_SLEEP_PATH=
IMAGE_TOOL_PATH=



###
# TOOL CONFIGURATION (OPTIONAL)

# Perplexity Sonar tool
# Provides Aurora with the ability to look up information using the Perplexity Sonar API. Set your
# PERPLEXITY_API_KEY to enable this tool.

PERPLEXITY_API_KEY=

# Cheese tool 
# Resolved disputes between two children using the concept of a 'cheese night'. If it's a child's 
# cheese night they win any argument and get their first choice of chores. Currently only supports
# two children and requires KID_NAME_A and KID_NAME_B to be set.

KID_NAME_A=
KID_NAME_B=

# Todoist tool
# Todoist API key and project IDs for organizing tasks. Leave blank to disable.
# Due details accept natural language (e.g., "Today", "tomorrow 6pm").

TODOIST_API_KEY=
TODOIST_TODO_PROJECT_ID=
TODOIST_SHOPPING_PROJECT_ID=
TODOIST_TODO_DUE_DETAILS=Today
TODOIST_SHOPPING_DUE_DETAILS=Saturday

# Bay Area 511 next transit tool
# Set these to enable predicted arrival times for a public transit route.
# FRIENDLY_NAME should include the line as the first word, e.g. "L train" or "38 bus".
BAY_AREA_511_API_KEY=
BAY_AREA_511_AGENCY=
BAY_AREA_511_STOP_CODE=
BAY_AREA_511_FRIENDLY_NAME=

# Default timer audio file
# Optional path to a default alarm sound file for immediate timer feedback.
# This file will be played immediately when a timer is set, then replaced with
# custom audio once it's generated. The file should be in WAV format.
DEFAULT_TIMER_AUDIO_FILE=

# Flash briefing tool
# "Aurora, play my flash briefing" downloads the most recent episode of this podcast
# feed and plays it through the audio queue. Defaults to the BBC Global News Podcast.
# Requires ffmpeg to be installed on the device (e.g. 'apt install ffmpeg') to transcode
# the downloaded MP3 for playback.
FLASH_BRIEFING_URL=

# LIFX smart light control
# Authentication token from the LIFX cloud portal (https://cloud.lifx.com/settings)
# and JSON mapping of friendly light names to LIFX selectors. Selectors can be IDs,
# labels, or groups - see LIFX API docs for details.
# Example: {"living room": "id:d073d5012345", "hallway": "label:Hall Light", "porch": "group:Front"}
LIFX_AUTH_TOKEN=
LIFX_LIGHTS={}

# Analytics (optional)
# Post simple event analytics to an HTTP endpoint. All three values must be set to enable.
ANALYTICS_URL=
ANALYTICS_SOURCE=
ANALYTICS_API_KEY=

# Recipes folder (optional)
# Path to a folder containing recipes for Aurora to use.
RECIPES_FOLDER=

###
# LOGGING (OPTIONAL)

# LOG_LEVEL may be set to DEBUG, INFO, WARNING, ERROR, or CRITICAL. Set LOG_FILE to output logs to a file.

LOG_LEVEL=INFO
LOG_FILE=
